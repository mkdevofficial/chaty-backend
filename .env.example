# Chaty backend configuration. The defaults below match the deployment target.
PORT=4444
HOST=0.0.0.0

# Public URL used in documentation / generated links.
PUBLIC_BASE_URL=http://185.196.20.220:5050

DATA_DIR=data
UPLOAD_DIR=uploads
# Optional absolute or relative path override:
# DB_PATH=data/chaty.db

# Session lifetime in days.
SESSION_TTL_DAYS=30
# bcrypt cost factor.
BCRYPT_ROUNDS=12

# Upload limits in megabytes.
MAX_IMAGE_MB=10
MAX_AUDIO_MB=10
MAX_FILE_MB=25
MAX_AVATAR_MB=10
MAX_STORY_MB=10

# Message and story limits.
MAX_MESSAGE_TEXT=5000
MAX_STORY_TEXT=500
STORY_TTL_HOURS=24
CLEANUP_INTERVAL_MINUTES=5

# Rate limits: max requests per window per IP.
LOGIN_RATE_MAX=20
LOGIN_RATE_WINDOW_MINUTES=15
REGISTER_RATE_MAX=10
REGISTER_RATE_WINDOW_MINUTES=60
SEARCH_RATE_MAX=60
SEARCH_RATE_WINDOW_MINUTES=1

# info | debug | warn | error
LOG_LEVEL=info
